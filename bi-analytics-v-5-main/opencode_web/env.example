# Copy to opencode_web/.env for local run. On Streamlit Cloud use app Secrets (same keys).

ENABLE_SSH_TUNNEL=true
AI_SSH_HOST=<AI_SERVER_HOST>
AI_SSH_PORT=2275
AI_SSH_USER=<SSH_USER>
AI_SSH_PASSWORD=<SSH_PASSWORD>
AI_OPENCODE_REMOTE_PORT=4096
# 0 = dynamic local port (recommended on Windows). Fixed example: 4096
AI_LOCAL_TUNNEL_PORT=0
# Used when SSH is off; with tunnel health checks use 127.0.0.1
OPENCODE_URL=http://127.0.0.1:4096

# Optional: public URL for browser link (Streamlit Cloud / remote users).
# Prod (ai.conall.ru): nginx subpath /opencode -> 127.0.0.1:4096
OPENCODE_PUBLIC_UI_BASE=https://ai.conall.ru/opencode
OPENCODE_USE_PUBLIC_UI_BASE=true
XCA_WORKSPACE_DIR=/workspace

# BI dashboard sidebar (Streamlit Cloud secrets) — нативный OpenCode:
# AI_ASSISTANT_TARGET = "auto"
# AI_ASSISTANT_URL = "https://opencode.conall.ru/L3dvcmtzcGFjZQ/"
